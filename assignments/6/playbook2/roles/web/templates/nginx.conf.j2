server {
    listen 80;
    server_name 98.84.21.117;

    root /var/www/html/;
    index index.html index.htm index.php;

    location / {
            try_files $uri $uri/ =404;
    }

    location ~* \.(jpg|jpeg|png|gif|css|js|svg|ico)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }
}
